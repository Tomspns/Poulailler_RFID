<Window x:Class="RFIDwpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lecteur RFID" Height="400" Width="600"
        MinHeight="350" MinWidth="500"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#6366F1"/>
        <SolidColorBrush x:Key="SecondaryBrush" Color="#F59E0B"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#10B981"/>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextBrush" Color="#1F2937"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#6B7280"/>

        <Storyboard x:Key="FadeInAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                           From="0" To="1" Duration="0:0:0.6"
                           AccelerationRatio="0.3" DecelerationRatio="0.3"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" 
                           From="20" To="0" Duration="0:0:0.6"
                           AccelerationRatio="0.3" DecelerationRatio="0.3"/>
        </Storyboard>

        <Storyboard x:Key="CardHoverAnimation">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" 
                           To="1.02" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" 
                           To="1.02" Duration="0:0:0.2"/>
        </Storyboard>

        <Storyboard x:Key="CardLeaveAnimation">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" 
                           To="1" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" 
                           To="1" Duration="0:0:0.2"/>
        </Storyboard>

        <Storyboard x:Key="PulseAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                           From="1" To="0.3" Duration="0:0:1"
                           AutoReverse="True"/>
        </Storyboard>

        <Storyboard x:Key="SlideInFromLeft">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" 
                           From="-100" To="0" Duration="0:0:0.5"
                           AccelerationRatio="0.2" DecelerationRatio="0.4"/>
            <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                           From="0" To="1" Duration="0:0:0.5"/>
        </Storyboard>

        <Storyboard x:Key="SlideInFromRight">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" 
                           From="100" To="0" Duration="0:0:0.5"
                           AccelerationRatio="0.2" DecelerationRatio="0.4"/>
            <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                           From="0" To="1" Duration="0:0:0.5"/>
        </Storyboard>

        <Style x:Key="ModernLabel" TargetType="Label">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost"
                                        Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTextBlock" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="AnimatedCard" TargetType="Border">
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TransformGroup>
                        <ScaleTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard Storyboard="{StaticResource CardHoverAnimation}"/>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard Storyboard="{StaticResource CardLeaveAnimation}"/>
                </EventTrigger>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard Storyboard="{StaticResource FadeInAnimation}"/>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="MainGrid" 
                                   Storyboard.TargetProperty="Opacity" 
                                   From="0" To="1" Duration="0:0:0.8"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid x:Name="MainGrid" Background="{StaticResource BackgroundBrush}" Opacity="0">
        <Rectangle Height="80" VerticalAlignment="Top">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#6366F1" Offset="0"/>
                    <GradientStop Color="#8B5CF6" Offset="0.5"/>
                    <GradientStop Color="#06B6D4" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
            <Rectangle.RenderTransform>
                <TranslateTransform/>
            </Rectangle.RenderTransform>
            <Rectangle.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" 
                                           From="-20" To="20" Duration="0:0:4" AutoReverse="True"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Rectangle.Triggers>
        </Rectangle>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0" Opacity="0">
            <StackPanel.RenderTransform>
                <TranslateTransform Y="-30"/>
            </StackPanel.RenderTransform>
            <StackPanel.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard BeginTime="0:0:0.2">
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" 
                                           From="-30" To="0" Duration="0:0:0.6"/>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                                           From="0" To="1" Duration="0:0:0.6"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </StackPanel.Triggers>

            <TextBlock Text="LECTEUR RFID" 
                       FontFamily="Segoe UI"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>
            <Rectangle Height="2" Width="60" Fill="White" Opacity="0.7" Margin="0,5,0,0"/>
        </StackPanel>

        <Border Background="{StaticResource CardBrush}"
                CornerRadius="20"
                Margin="30,100,30,30"
                Padding="0"
                Style="{StaticResource AnimatedCard}"
                Opacity="0">
            <Border.Effect>
                <DropShadowEffect Color="#000000" 
                                Direction="270" 
                                ShadowDepth="5" 
                                BlurRadius="20" 
                                Opacity="0.1"/>
            </Border.Effect>
            <Border.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard BeginTime="0:0:0.4">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                                           From="0" To="1" Duration="0:0:0.8"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" 
                                           From="50" To="0" Duration="0:0:0.8"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>

            <StackPanel x:Name="myStackPanel" Margin="40,30">
                <Border Background="#F0F4FF" 
                        CornerRadius="16" 
                        Padding="24,20" 
                        Margin="0,0,0,20"
                        Opacity="0">

                    <Border.RenderTransform>
                        <TranslateTransform X="-100"/>
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect Color="#6366F1" 
                                        Direction="270" 
                                        ShadowDepth="0" 
                                        BlurRadius="20" 
                                        Opacity="0.1"/>
                    </Border.Effect>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard BeginTime="0:0:0.6">
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" 
                                                   From="-100" To="0" Duration="0:0:0.5"/>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                                                   From="0" To="1" Duration="0:0:0.5"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource PrimaryBrush}" 
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Label Content="Identifiant de la carte" 
                                   Style="{StaticResource ModernLabel}"
                                   Foreground="{StaticResource PrimaryBrush}"/>
                        </StackPanel>
                        <TextBox Name="txtIdentifiant" 
                                IsReadOnly="True" 
                                Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                </Border>

                <Border Background="#FFFBF0" 
                        CornerRadius="16" 
                        Padding="24,20" 
                        Margin="0,0,0,20"
                        Opacity="0">
                    <Border.RenderTransform>
                        <TranslateTransform X="100"/>
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect Color="#F59E0B" 
                                        Direction="270" 
                                        ShadowDepth="0" 
                                        BlurRadius="20" 
                                        Opacity="0.1"/>
                    </Border.Effect>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard BeginTime="0:0:0.8">
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" 
                                                   From="100" To="0" Duration="0:0:0.5"/>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                                                   From="0" To="1" Duration="0:0:0.5"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource SecondaryBrush}" 
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Label Content="Nom associé" 
                                   Style="{StaticResource ModernLabel}"
                                   Foreground="{StaticResource SecondaryBrush}"/>
                        </StackPanel>
                        <Border Background="White"
                                CornerRadius="12"
                                BorderThickness="2"
                                BorderBrush="#E5E7EB"
                                MinHeight="48">
                            <TextBlock Name="txtNom" 
                                     FontFamily="Segoe UI"
                                     FontSize="14"
                                     Foreground="{StaticResource TextBrush}"
                                     Padding="16,12"
                                     VerticalAlignment="Center"
                                     TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Vertical" Margin="0,20,0,0">
                    <!-- Autres éléments -->

                    <Button Content="Ajouter une Poule"
            Width="280"
            Height="45"
            Margin="0,10,0,0"
            Background="#5CB85C"
            Foreground="White"
            FontSize="15"
            FontWeight="Bold"
            BorderThickness="0"
            Padding="10"
            HorizontalAlignment="Center"
            Click="BtnAjouter_Click"/>

                    <Button Content="Modifier une Poule"
            Width="280"
            Height="45"
            Margin="0,10,0,0"
            Background="#F0AD4E"
            Foreground="White"
            FontSize="15"
            FontWeight="Bold"
            BorderThickness="0"
            Padding="10"
            HorizontalAlignment="Center"
            Click="BtnAjouter_Click"/>
                </StackPanel>

                <Border Background="#FEF2F2" 
                        CornerRadius="16" 
                        Padding="24,20"
                        Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect Color="#EF4444" 
                                        Direction="270" 
                                        ShadowDepth="0" 
                                        BlurRadius="20" 
                                        Opacity="0.1"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#EF4444" 
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <TextBlock Name="txtConnectionError" 
                                 Foreground="#DC2626" 
                                 FontFamily="Segoe UI"
                                 FontSize="14"
                                 FontWeight="Medium"
                                 TextWrapping="Wrap"
                                 VerticalAlignment="Center"
                                 Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
                <Button Content="Supprimer le dernier enregistrement"
                    Width="280"
                    Height="45"
                    Margin="0,20,0,0"
                    Background="#EF4444"
                    Foreground="White"
                    FontSize="15"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Padding="10"
                    HorizontalAlignment="Center"
                    Click="BtnDeleteLast_Click"/>
            </StackPanel>
        </Border>

        <Border Background="{StaticResource AccentBrush}"
                CornerRadius="8"
                Width="16" Height="16"
                HorizontalAlignment="Right" 
                VerticalAlignment="Top"
                Margin="0,30,40,0">
            <Border.Effect>
                <DropShadowEffect Color="#10B981" 
                                BlurRadius="12" 
                                ShadowDepth="0" 
                                Opacity="0.8"/>
            </Border.Effect>
            <Border.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard Storyboard="{StaticResource PulseAnimation}"/>
                </EventTrigger>
            </Border.Triggers>
        </Border>
    </Grid>
</Window>